# Database - Supabase PostgreSQL via pooler
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# JWT - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_this_with_a_64_char_hex_secret

# JWT expiry in minutes (default: 15)
JWT_EXPIRY_MINUTES=15

# Password policy
PASSWORD_MIN_LENGTH=16
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=5

# Account lockout
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=30

# Redis (optional, for session cache)
REDIS_URL=redis://localhost:6379/0

# Metrics endpoint password (separate from JWT)
METRICS_PASSWORD=generate_a_strong_password_here

# Set to true for development docs
DEBUG=true
