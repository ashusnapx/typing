[flake8]
max-line-length = 200
max-complexity = 15
# E203: whitespace before ':' (black compat)
# E266: too many leading '#' for block comment
# W503: line break before binary operator
# W504: line break after binary operator
# E501: line too long (handled by max-line-length above)
# F401: imported but unused (we have many; track separately)
# F403: wildcard imports (migrations need this)
# F405: undefined from wildcard
# F841: local variable assigned but not used
# E712: comparison to True (many legacy instances)
# F541: f-string missing placeholders (warning only)
extend-ignore = E203, E266, W503, W504, F401, F403, F405, F841, E712, F541
exclude = .git,__pycache__,venv,.env,migrations/versions,node_modules,tests
per-file-ignores =
    __init__.py: F401
    app/migrations/env.py: F401, F403
